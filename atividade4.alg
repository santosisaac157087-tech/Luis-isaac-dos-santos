algoritmo "Imposto"

var
Nome: caractere
Renda: real

inicio
escreval("Qual seu Nome?: ")
leia(Nome)
escreval("Quando foi seu valor anual?: ")
leia(Renda)

se (Renda <= 22847.76) entao
    escreval("Você não paga imposto de renda!")
    senao
    escreval("Você paga imposto de renda!")
    fimse






fimalgoritmo